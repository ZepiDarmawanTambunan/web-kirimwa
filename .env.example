MYSQL_DATABASE=wa_gateway
MYSQL_USER=wa_gateway
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
APP_ENV=development
LOCAL_DATABASE_URL=mysql://root@127.0.0.1:3306/wa_gateway
JWT_SECRET=replace-with-at-least-32-random-bytes
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GATEWAY_TOKEN=replace-with-at-least-32-random-characters
DEVICE_CREDENTIALS_KEY=replace-with-64-hex-characters-for-aes-256-gcm
META_GRAPH_API_VERSION=v24.0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD_HASH='replace-with-output-from-hash-admin-password'
WEB_ORIGIN=http://localhost:3003
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8081
API_BIND=127.0.0.1
API_PORT=8081
WEB_BIND=127.0.0.1
WEB_PORT=3003
BAILEYS_PORT=4000
BAILEYS_GATEWAY_URL_LOCAL=http://127.0.0.1:4000
BAILEYS_GATEWAY_URL_DOCKER=http://baileys:4000
BACKEND_STATUS_WEBHOOK_BASE_LOCAL=http://127.0.0.1:8081
BACKEND_STATUS_WEBHOOK_BASE_DOCKER=http://api:8080
